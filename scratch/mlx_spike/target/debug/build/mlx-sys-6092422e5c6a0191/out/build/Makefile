mlx/c/version.i: mlx/c/version.cpp.i
.PHONY : mlx/c/version.i

# target to preprocess a source file
mlx/c/version.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/mlxc.dir/build.make CMakeFiles/mlxc.dir/mlx/c/version.cpp.i
.PHONY : mlx/c/version.cpp.i

mlx/c/version.s: mlx/c/version.cpp.s
.PHONY : mlx/c/version.s

# target to generate assembly for a file
mlx/c/version.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/mlxc.dir/build.make CMakeFiles/mlxc.dir/mlx/c/version.cpp.s
.PHONY : mlx/c/version.cpp.s

